<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>
			net20;net35;
			net40;
			net45;net46;net47;net48;
			net8.0;
		</TargetFrameworks>
		<!--project-->
		<RootNamespace>Cave.Service</RootNamespace>
		<AssemblyOriginatorKeyFile>Cave.Service.snk</AssemblyOriginatorKeyFile>
		<Product>CaveSystems Service Library</Product>
		<PackageTags>CaveSystems Service</PackageTags>
		<Description>CaveSystems Service Library. Provides service (windows), daemon (*nix/macos) and console (debugmode) execution. </Description>
		<PackageProjectUrl>https://github.com/CaveSystems/cave-service</PackageProjectUrl>
		<RepositoryUrl>https://github.com/CaveSystems/cave-service</RepositoryUrl>
		<!--settings-->
		<NeutralLanguage />
		<PackageReleaseNotes />
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<!-- framework includes -->
	<Choose>
		<When Condition=" '$(TargetFramework)'=='net20' OR '$(TargetFramework)'=='net35' ">
			<ItemGroup>
				<Reference Include="System" />
				<Reference Include="System.Data" />
				<Reference Include="System.ServiceProcess" />
				<Reference Include="System.Management" />
				<Reference Include="System.Web" />
				<Reference Include="System.Configuration.Install" />
				<Reference Include="System.Windows.Forms" />
			</ItemGroup>
		</When>

		<When Condition=" $(TargetFramework.StartsWith('net4')) ">
			<ItemGroup>
				<Reference Include="System" />
				<Reference Include="System.Core" />
				<Reference Include="Microsoft.CSharp" />
				<Reference Include="System.Data" />
				<Reference Include="System.ServiceProcess" />
				<Reference Include="System.Management" />
				<Reference Include="System.Configuration.Install" />
				<Reference Include="System.Windows.Forms" />
			</ItemGroup>
		</When>

		<Otherwise>
			<!-- > net 5.0 -->
			<ItemGroup>
				<PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.8" />
				<PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.8" />
				<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
			</ItemGroup>
		</Otherwise>
	</Choose>

	<!-- nuget packages -->
	<ItemGroup>
		<PackageReference Include="Cave.Console" Version="4.0.4" />
		<PackageReference Include="Cave.Extensions" Version="4.0.11" />
		<PackageReference Include="Cave.IO" Version="4.0.8" />
		<PackageReference Include="Cave.Logging" Version="4.0.8" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.300" />
	</ItemGroup>

</Project>
